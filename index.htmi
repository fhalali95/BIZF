<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BIZF</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background: #f5f6f8;
  color: #181818;
}

header {
  background: white;
  padding: 22px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #e5e5e5;
}

.logo {
  font-size: 28px;
  font-weight: bold;
  letter-spacing: 2px;
}

.profile {
  background: #111;
  color: white;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

main {
  width: 86%;
  max-width: 1200px;
  margin: 40px auto;
}

h1 {
  font-size: 32px;
  margin-bottom: 8px;
}

.subtitle {
  color: #777;
  margin-bottom: 30px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.card {
  background: white;
  padding: 24px;
  border-radius: 16px;
  border: 1px solid #e7e7e7;
}

.card-title {
  color: #777;
  font-size: 14px;
  margin-bottom: 12px;
}

.amount {
  font-size: 26px;
  font-weight: bold;
}

.goal {
  background: #111;
  color: white;
  margin-top: 25px;
  padding: 28px;
  border-radius: 18px;
}

.goal h2 {
  margin-bottom: 10px;
}

.progress {
  background: #333;
  height: 10px;
  border-radius: 10px;
  margin-top: 20px;
  overflow: hidden;
}

.progress-bar {
  width: 0%;
  height: 100%;
  background: white;
}

.quick-actions {
  margin-top: 30px;
}

.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 15px;
}

button {
  background: white;
  border: 1px solid #ddd;
  padding: 14px 20px;
  border-radius: 12px;
  cursor: pointer;
  font-size: 15px;
}

button:hover {
  background: #111;
  color: white;
}

@media (max-width: 800px) {
  .cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 500px) {
  .cards {
    grid-template-columns: 1fr;
  }

  main {
    width: 92%;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">BIZF</div>
  <div class="profile">B</div>
</header>

<main>

<h1>Good evening 👋</h1>
<p class="subtitle">Here's how your business is doing today.</p>

<section class="cards">

  <div class="card">
    <div class="card-title">Sales</div>
    <div class="amount">AED 0</div>
  </div>

  <div class="card">
    <div class="card-title">Expenses</div>
    <div class="amount">AED 0</div>
  </div>

  <div class="card">
    <div class="card-title">Net Profit</div>
    <div class="amount">AED 0</div>
  </div>

  <div class="card">
    <div class="card-title">Orders</div>
    <div class="amount">0</div>
  </div>

</section>

<section class="goal">
  <h2>Monthly Profit Goal 🎯</h2>
  <p>AED 0 of AED 10,000</p>

  <div class="progress">
    <div class="progress-bar"></div>
  </div>
</section>

<section class="quick-actions">

  <h2>Quick Actions</h2>

  <div class="buttons">
    <button>+ New Order</button>
    <button>+ Add Expense</button>
    <button>+ Add Product</button>
    <button>Create Invoice</button>
  </div>

</section>

</main>

</body>
</html>
